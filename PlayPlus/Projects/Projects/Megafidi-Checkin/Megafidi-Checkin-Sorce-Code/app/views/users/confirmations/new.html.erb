<div class="row justify-content-center">
  <div class="col-4">
    <div class="card mt-3">
      <div class="card-header">
        <h1><%= t('devise.confirmations.new.resend_confirmation_instructions') %></h1>
      </div>
      <div class="card-body">
        <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), builder: BootstrapVerticalFormBuilder, html: { method: :post }) do |f| %>

        <%= f.email_field :email, autofocus: true, autocomplete: 'email', value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email), class: 'form-control' %>
        
        <div class="form-group my-3">
          <%= f.submit_without_bootstrap t('devise.confirmations.new.resend_confirmation_instructions'), class: 'btn w-100 btn-primary' %>
        </div>
        <% end %>

        <%= render '/users/shared/links' %>

      </div>
    </div>    
  </div>
</div>