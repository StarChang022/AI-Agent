<div class="table-responsive">
  <table class="table table-sm table-bordered">
    <thead>
      <tr class="">
        <% OmniauthUser.form_columns_hash.each do |current, type| %>
        <th class="text-center w-16"><%= OmniauthUser.human_attribute_name(current) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="">
			<% current_user.omniauth_users.each do |omniauth_user| %>
			<tr>
        <% OmniauthUser.form_columns_hash.each do |current, type| %>
				<td><%= omniauth_user.send(current) %></td>
				<% end %>
			</tr>
			<% end %>
    </tbody>
  </table>
</div>