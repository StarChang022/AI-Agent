<div class="table">
  <div>
    <!-- 表頭 -->
    <div class="thead tr">
      <div class="flex justify-center">
        <input class="form-check-input toggle" type="checkbox" value="" id="toggle_bulk_ids">
        <label class="form-check-label" for="toggle_bulk_ids"></label>
        <!-- <input type="checkbox" class="thead__checkbox"> -->
      </div>

      <p class="text-center min-w-[83.5px]">狀態</p>

      <p>權限</p>

      <p>名稱</p>

      <p>電話</p>

      <p class="text-center">備註</p>

      <p class="text-center">操作</p>
    </div>

    <%= render partial: "/home/admins/partials/admin", collection: pagy_current_collection, as: :current_object %>
  </div>

  <!-- 備註彈窗 -->
  <div id="remark-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center !items-start md:inset-0 h-[calc(100%-1rem)] max-h-full">
    <div class="relative p-4 w-full max-w-lg max-h-full">
      <!-- Modal content -->
      <div class="relative translate-y-[50px] bg-white rounded-lg shadow">
        <!-- Modal header -->
        <div class="flex items-center justify-between p-6 pb-0 rounded-t">
          <h3 class="text-xl font-semibold text-gray-900">
            備註
          </h3>
          <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="remark-modal">
            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
            </svg>
            <span class="sr-only">Close modal</span>
          </button>
        </div>
        <!-- Modal body -->
        <div class="p-6 pt-3">
          <p class="text-base leading-relaxed text-gray-500">
            備註內容
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
  	const theadCheckbox = document.querySelector('.thead__checkbox');
  	const tbodyCheckboxes = document.querySelectorAll('.tbody__checkbox');

  	theadCheckbox.addEventListener('change', () => {
  		tbodyCheckboxes.forEach(checkbox => {
  			checkbox.checked = theadCheckbox.checked;
  		});
  	});

  	tbodyCheckboxes.forEach(checkbox => {
  		checkbox.addEventListener('change', () => {
  			const allChecked = Array.from(tbodyCheckboxes).every(checkbox => checkbox.checked);

  			theadCheckbox.checked = allChecked;
  		});
  	});
  });
</script>