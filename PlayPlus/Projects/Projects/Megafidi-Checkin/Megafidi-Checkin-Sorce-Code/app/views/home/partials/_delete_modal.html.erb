<!-- 彈窗 -->
<div id="delete-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center !items-start md:inset-0 h-[calc(100%-1rem)] max-h-full">
	<div class="relative p-4 w-full max-w-lg max-h-full">
			<!-- Modal content -->
			<div class="relative translate-y-[50px] bg-white rounded-lg shadow">
					<!-- Modal header -->
					<div class="flex items-center justify-between p-6 pb-0 rounded-t">
							<h3 class="text-xl font-semibold text-gray-900">
									確認刪除
							</h3>
							<button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="delete-modal">
									<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
											<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
									</svg>
									<span class="sr-only">Close modal</span>
							</button>
					</div>
					<!-- Modal body -->
					<div class="p-6 pt-3">
							<p class="text-base leading-relaxed text-gray-500">
								您即將刪除此筆資料，請確認是否繼續？
							</p>
					</div>

					<!-- Modal footer -->
					<div class="flex items-center justify-end p-6 pt-3 rounded-b gap-3">
						<button data-modal-hide="delete-modal" type="button" class="button button--outline">取消</button>

						<button data-modal-hide="delete-modal" type="button" class="button button--destructive">確認</button>
					</div>
			</div>
	</div>
</div>