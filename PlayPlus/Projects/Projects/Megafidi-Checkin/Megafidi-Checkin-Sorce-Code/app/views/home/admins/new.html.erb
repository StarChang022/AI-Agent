<%= form_with model: [:home, current_object], multipart: true, local: true, class: "" do |f| %>
  <div class="users flex flex-col gap-6">
    <span class="text-sm">
      <%= link_to('工作人員', home_admins_path) %>
      / 
      <%= current_object.new_record? ? "新增" : current_object.name %>
    </span>

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%= link_to :back do %>
          <div class="return-button">
            <i class="scale-75 fa-solid fa-chevron-left"></i>
          </div>
        <% end %>

        <h2 class="text-2xl"><%= current_object.new_record? ? "新增" : current_object.name %></h2>
      </div>

      <div class="flex items-center gap-3">
        <% unless current_object.new_record? %>
          <%= link_to(url_for(action: :destroy),class: "button button--destructive-outline", method: :delete, data: {confirm: t("backends.confirm", action:  t("backends.destroy")) }) do %>
            <i class="fa-solid fa-trash-can"></i>
            刪除
          <% end %>
        <% end %>

        <a href="<%= home_admins_path %>" class="button button--outline">
          <i class="fa-solid fa-times"></i>
          取消
        </a>

        <button type="submit" class="button">
          <i class="fa-solid fa-check"></i>
          儲存
        </button>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start gap-6">
      <div class="lg:basis-2/3 flex flex-col gap-6">
        <div class="card">
          <h3 class="text-lg">基本資料</h3>

          <div class="grid grid-cols-2 gap-6">
            <div class="input">
              <%= f.label :name %>
              <%= f.text_field :name, placeholder: "請輸入姓名" %>
            </div>

            <div class="input">
              <%= f.label :phone %>
              <%= f.text_field :phone, placeholder: "請輸入姓名", oninput: "value=value.replace(/[^\d]/g, '')", minlength: 10, maxlength: 10 %>
            </div>

            <div class="input col-span-2">
              <%= f.label :note %>
              <%= f.text_area :note, placeholder: "請輸入備註" %>
            </div>
          </div>
        </div>

        <div class="card">
          <h3 class="text-lg">帳號</h3>

          <div class="grid grid-cols-2 gap-6">
            <div class="input col-span-2">
              <%= f.label :email %>
              <%= f.email_field :email, placeholder: "請輸入帳號" %>
            </div>

            <div class="input">
              <%= f.label :password %>
              <%= f.password_field :password, autocomplete: 'current-password', placeholder: "請輸入密碼", required: f.object.new_record? %>
              <ul class="mt-1.5 list-decimal list-inside text-xs text-gray-theme-light">
                <li>需要修改密碼時才填寫。</li>
                <li>密碼至少八位數。</li>
              </ul>
            </div>

            <div class="input">
              <%= f.label :password_confirmation %>
              <%= f.password_field :password_confirmation, autocomplete: 'current-password', placeholder: "請再次輸入密碼", required: f.object.new_record?  %>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:basis-1/3">
        <div class="card">
          <h3 class="text-lg">權限</h3>
          <div class="select">
            <%= f.label :status, Admin.human_attribute_name(:status) %>
            <%= f.select(:status, Admin.statuses.keys.collect{|i| [Admin.human_attribute_name(i), i]}, {include_blank: false}, {class: ""}) %>
          </div>

          <div class="select">
            <%= f.label :role, Admin.human_attribute_name(:role) %>
            <%= f.select(:role, Admin.roles.keys.collect{|i| [Admin.human_attribute_name(i), i]}, {include_blank: false}, {class: ""}) %>
            <p class="mt-1.5 text-xs text-gray-theme-light">一般人員僅能使用數位報到功能。</p>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>