<div class="users flex flex-col gap-6">
	<span class="text-sm">工作人員 / <%= '姓名姓名' %></span>

	<div class="flex items-center justify-between">
		<div class="flex items-center gap-3">
			<%= link_to :back do %>
				<div class="return-button">
					<i class="scale-75 fa-solid fa-chevron-left"></i>
				</div>
			<% end %>

			<h2 class="text-2xl"><%= '姓名姓名' %></h2>
		</div>

		<div class="flex items-center gap-3">
			<button type="button" data-modal-target="delete-modal" data-modal-toggle="delete-modal" class="button button--destructive-outline">
				<i class="fa-solid fa-trash-can"></i>

				刪除
			</button>

			<a href="<%= users_path %>" class="button button--outline">
				<i class="fa-solid fa-times"></i>

				取消
			</a>

			<button type="button" class="button">
				<i class="fa-solid fa-check"></i>
	
				儲存
			</button>
		</div>
	</div>

	<div class="flex flex-col lg:flex-row lg:items-start gap-6">
		<div class="lg:basis-2/3 flex flex-col gap-6">
			<div class="card">
				<h3 class="text-lg">基本資料</h3>
	
				<div class="grid grid-cols-2 gap-6">
					<div class="input">
						<label for="name">姓名</label>
	
						<input id="name" type="text" placeholder="請輸入姓名">
					</div>
	
					<div class="input">
						<label for="phone">手機號碼</label>
	
						<input id="phone" type="text" oninput="value=value.replace(/[^\d]/g, '')" minlength="10" maxlength="10" placeholder="請輸入手機號碼">
					</div>
	
					<div class="input col-span-2">
						<label for="remark">備註</label>
	
						<textarea id="remark" placeholder="請輸入備註"></textarea>
					</div>
				</div>
			</div>

			<div class="card">
				<h3 class="text-lg">帳號</h3>
	
				<div class="grid grid-cols-2 gap-6">
					<div class="input col-span-2">
						<label for="account">帳號</label>
	
						<input id="account" type="text" placeholder="請輸入帳號">
					</div>

					<div class="input">
						<label for="password">密碼</label>

						<input id="password" type="password" minlength="8" maxlength="8" placeholder="請輸入密碼">

						<ul class="mt-1.5 list-decimal list-inside text-xs text-gray-theme-light">
							<li>需要修改密碼時才填寫。</li>
							<li>密碼至少八位數。</li>
						</ul>
					</div>

					<div class="input">
						<label for="password-confirmation">密碼確認</label>

						<input id="password-confirmation" type="password" placeholder="請再次輸入密碼">
					</div>
				</div>
			</div>
		</div>
		
		<div class="lg:basis-1/3">
			<div class="card">
				<h3 class="text-lg">權限</h3>
	
				<!-- 是否報到 -->
				<button type="button" class="button button--sm self-start">
					正常
	
					<i class="scale-75 fa-solid fa-chevron-down"></i>
				</button>
	
				<div class="select">
					<label for="permission">權限</label>
	
					<select name="" id="permission"></select>
	
					<p class="mt-1.5 text-xs text-gray-theme-light">一般人員僅能使用數位報到功能。</p>
				</div>
			</div>
		</div>
	</div>
</div>

<%= render partial: "/home/partials/delete_modal" %>