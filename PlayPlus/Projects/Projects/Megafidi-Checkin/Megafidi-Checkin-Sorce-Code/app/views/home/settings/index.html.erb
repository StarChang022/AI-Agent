<div class="settings flex flex-col gap-6">
	<span class="text-sm">選項設定</span>

	<div class="flex items-center justify-between">
		<div class="flex items-center gap-3">
			<%= link_to :back do %>
				<div class="return-button">
					<i class="scale-75 fa-solid fa-chevron-left"></i>
				</div>
			<% end %>

			<h2 class="text-2xl">選項設定</h2>
		</div>
	</div>

	<!-- 操作列 -->
	<%= render partial: "/home/partials/actions" %>

	<!-- 搜尋列 -->
	<%= render partial: "/home/settings/partials/search" %>

	<div class="card !p-6">
		<div class="flex items-center gap-3">
			<h3 class="text-lg">活動場次</h3>

			
			<button type="button" data-modal-target="edit-modal" data-modal-toggle="edit-modal" class="button button--sm">
				<i class="fa-solid fa-plus"></i>

				新增
			</button>
		</div>

		<!-- 搜尋列 -->
		<%= render partial: "/home/settings/partials/table" %>
	</div>
</div>

<!-- 編輯彈窗 -->
<div id="edit-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center !items-start md:inset-0 h-[calc(100%-1rem)] max-h-full">
	<div class="relative p-4 w-full max-w-lg max-h-full">
			<!-- Modal content -->
			<div class="relative translate-y-[50px] bg-white rounded-lg shadow">
					<!-- Modal header -->
					<div class="flex items-center justify-between p-6 pb-0 rounded-t">
							<h3 class="text-xl font-semibold text-gray-900">
									活動場次
							</h3>
							<button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="edit-modal">
									<svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
											<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
									</svg>
									<span class="sr-only">Close modal</span>
							</button>
					</div>
					<!-- Modal body -->
					<div class="px-6 py-3 flex flex-col gap-3">
						<div class="input">
							<label for="name">名稱</label>

							<input id="name" type="text">
						</div>

						<div class="input">
							<label for="event-date">日期</label>

							<input id="event-date" type="text" class="datepicker">
						</div>
					</div>

					<!-- Modal footer -->
					<div class="flex items-center justify-end p-6 pt-3 rounded-b gap-3">
						<button type="button" data-modal-target="delete-modal" data-modal-toggle="delete-modal" data-modal-hide="edit-modal" class="button button--destructive-outline">
							<i class="fa-solid fa-trash-can"></i>
			
							刪除
						</button>

						<button data-modal-hide="edit-modal" type="button" class="button button--outline">取消</button>

						<button data-modal-hide="edit-modal" type="button" class="button">儲存</button>
					</div>
			</div>
	</div>
</div>

<%= render partial: '/home/partials/delete_modal' %>