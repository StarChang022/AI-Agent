$(document).ready(function(){
  $("#<%= dom_id(current_object) %>").replaceWith('<%= escape_javascript(render(partial: "/home/admins/partials/admin",locals:{current_object: current_object})) %>');
  <% if @message %>
  new Noty({
    type: 'success',
    text: '<%= @message %>'
  }).show();
  <% end %>
});