<%= form_with model: [:home, current_object], multipart: true, local: true, class: "" do |f| %>
  <div class="guests flex flex-col gap-6">
    <span class="text-sm">
      <%= link_to('賓客資料', home_guests_path) %>
      / 
      <%= current_object.new_record? ? "新增" : current_object.name %>
    </span>


    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <%= link_to home_guests_path do %>
          <div class="return-button">
            <i class="scale-75 fa-solid fa-chevron-left"></i>
          </div>
        <% end %>

        <h2 class="text-2xl"><%= current_object.new_record? ? "新增" : current_object.name %></h2>
      </div>

      <div class="flex items-center gap-3">
        <% unless current_object.new_record? %>
          <%= link_to(url_for(action: :destroy),class: "button button--destructive-outline", method: :delete, data: {confirm: t("backends.confirm", action:  t("backends.destroy")) }) do %>
            <i class="fa-solid fa-trash-can"></i>
            刪除
          <% end %>
        <% end %>

        <a href="<%= url_for(action: :index) %>" class="button button--outline">
          <i class="fa-solid fa-times"></i>
          取消
        </a>

        <button type="submit" class="button">
          <i class="fa-solid fa-check"></i>
          儲存
        </button>
      </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start gap-6">
      <div class="card lg:basis-2/3">
        <h3 class="text-lg">基本資料</h3>

        <div class="flex items-center gap-3">
          <!-- 是否貴賓 -->
          <% if current_object.special %>
            <button type="button" class="button button--sm">
              貴賓
              <i class="scale-75 fa-solid fa-chevron-down"></i>
            </button>
          <% end %>
        </div>
        <div class="grid grid-cols-2 gap-6">

          <div class="select">
            <%= f.label :special, Guest.human_attribute_name(:special) %>
            <%= f.select(:special, [['貴賓', true], ['一般', false]], {include_blank: false}, {class: ""}) %>
          </div>

          <div class="select">
            <%= f.label :activity_id, Activity.model_name.human %>
            <%= f.select(:activity_id, activities.collect{|i| [i.name, i.id]}, {include_blank: false}, {class: ""}) %>
          </div>

        </div>

        <div class="grid grid-cols-2 gap-6">
          <div class="input">
            <%= f.label :name %>
            <%= f.text_field :name, placeholder: "請輸入姓名" %>
          </div>
          <div class="input">
            <%= f.label :phone %>
            <%= f.text_field :phone, placeholder: "請輸入手機號碼", minlength: 10, maxlength: 10 %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="input">
            <%= f.label :company_name %>
            <%= f.text_field :company_name, placeholder: "請輸入公司名稱" %>
          </div>
          <div class="input">
            <%= f.label :department_name %>
            <%= f.text_field :department_name, placeholder: "請輸入單位名稱" %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="input">
            <%= f.label :certificate_num %>
            <%= f.text_field :certificate_num, placeholder: "請輸入完整字號" %>
          </div>
          <div class="input">
            <%= f.label :trophy_num %>
            <%= f.text_field :trophy_num, placeholder: "請輸入獎盃編號" %>
          </div>
        </div>
      </div>

      <div class="card lg:basis-1/3">
        <h3 class="text-lg">報到</h3>

        <div class="flex flex-col gap-6">

          <!-- 是否報到 -->
          <div class="select">
            <%= f.label :event, Guest.human_attribute_name(:status) %>
            <select name="event">
              <option value=""><%= current_object.status_human %></option>
              <% current_object.aasm(:status).events(:permitted => true).map(&:name).each do |event| %>
                <option value="<%= event %>"><%= Guest.human_attribute_name(event) %></option>
              <% end %>
            </select>
          </div>


          <div class="input">
            <%= f.label :behalf %>
            <%= f.text_field :behalf, placeholder: "請輸入代領獎人姓名" %>
          </div>

          <div class="input">
            <%= f.label :note %>
            <%= f.text_area :note, placeholder: "請輸入備註" %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
