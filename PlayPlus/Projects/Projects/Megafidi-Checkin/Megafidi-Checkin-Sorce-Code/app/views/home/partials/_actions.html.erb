<div class="actions flex items-center gap-3">
  <!-- 批量操作 -->
  <div class="relative">

    <div class="dropdown">
      <button class="button button--sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        批次
      </button>
      <ul class="dropdown-menu">
        <% model_events.each do |current| %>
          <a href="javaScript:void();" class="dropdown-item" data-bulk_action="bulk_event" data-bulk_event="<%= current %>" data-v_confirm="<%= t("backends.confirm", action: model_class.human_attribute_name(current)) %>"><%= model_class.human_attribute_name(current) %></a>
        <% end %>
        <div class="dropdown-divider"></div>
        <a href="javaScript:void();" class="dropdown-item" data-bulk_action="bulk_delete" data-_confv_confirmirm="<%= t("backends.confirm", action: t("backends.destroy")) %>">批次刪除</a>
      </ul>
    </div>

    <%= form_with url: url_for(action: :bulk_action), builder: BootstrapHorizontalFormBuilder, method: :post, multipart: true, local: true, id: "bulk_form" do |f| %>

      <%= f.hidden_field :bulk_action %>
      <%= f.hidden_field :bulk_event %>

      <div class="bulk_ids d-none">

      </div>
    <% end %>

  </div>

  <div class="w-px h-6 bg-gray-theme-light"></div>

  <button class="actions__search-toggle button button--sm">
    <i class="text-xs fa-solid fa-magnifying-glass"></i>

    搜尋
  </button>

  <div class="w-px h-6 bg-gray-theme-light"></div>

  <p class="text-sm"><%= raw pagy_info(current_pagy) %></p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  	const searchButton = document.querySelector('.actions__search-toggle');
  	const searchBar = document.querySelector('.search');

  	searchButton.addEventListener('click', () => {
  		searchBar.classList.toggle('hidden');
  	});
  });
</script>