<div class="p-6 flex flex-col gap-6 sticky top-0 bg-orange-theme-lightest z-30">
  <div class="card">
    <div class="flex items-center justify-between gap-3">
			<div>
				<button type="button" class="xl:hidden menu__button hover:text-orange-theme flex items-center justify-center duration-200">
					<i class="text-xl fa-solid fa-bars fa-fw"></i>
				</button>
			</div>

			<div class="relative">
				<button type="button" class="user__button hover:text-orange-theme flex items-center justify-center duration-200">
					<i class="text-xl fa-solid fa-circle-user fa-fw"></i>
				</button>
	
				<div class="user__dropdown hidden absolute border p-3 w-[100px] flex flex-col text-center gap-3 right-0 -bottom-1.5 translate-y-full bg-white rounded shadow-lg">
					<a href="#" class="hidden block hover:text-orange-theme duration-200">編輯資料</a>
	
					<%= link_to(destroy_admin_session_path, method: :delete, data: {confirm: "確認登出嗎?"}, class: "block text-red-theme hover:text-red-theme-light duration-200") do %>
						登出
					<% end %>
				</div>
			</div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
  	const userButton = document.querySelector('.user__button');
  	const userDropdown = document.querySelector('.user__dropdown');
		const sidebar = document.querySelector('.sidebar');
		const menuButton = document.querySelector('.menu__button');
		const backdrop = document.querySelector('.backdrop');

  	userButton.addEventListener('click', () => {
  		userDropdown.classList.toggle('hidden');
  	});

  	document.addEventListener('click', (event) => {
  		if (!userButton.contains(event.target) && !userDropdown.contains(event.target)) {
  			userDropdown.classList.add('hidden');
  		}
  	});

		menuButton.addEventListener('click', () => {
			const screen = document.documentElement.clientWidth;

			if (screen < 1024) {
				sidebar.classList.toggle('w-0');
				sidebar.classList.toggle('w-[260px]');
				backdrop.classList.toggle('opacity-0');
				backdrop.classList.toggle('pointer-events-none');
			} else if (screen >= 1024 && screen < 1280) {
				sidebar.classList.toggle('lg:w-0');
				sidebar.classList.toggle('lg:w-[260px]');
			}
		});
  });
</script>