<!-- 內容 -->
<div class="tbody tr">
  <div class="flex justify-center">
    <!-- <input type="checkbox" class="tbody__checkbox"> -->

    <div class="form-check form-check-inline">
      <input class="form-check-input"  type="checkbox" id="_<%= dom_id(current_object) %>" name="bulk_ids[]" value="<%= current_object.id %>">
      <label class="form-check-label" for="_<%= dom_id(current_object) %>"> </label>
    </div>
  </div>

  <!-- 判斷使用者狀態 -->
  <div class="flex items-center justify-center">
    <div class="dropdown m-2">
      <button class="tag <%= 'active' if current_object.active? %> dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <%= current_object.status_human %>
      </button>
      <ul class="dropdown-menu" style="">
        <% current_object.aasm(:status).events(:permitted => true).map(&:name).each do |event| %>
          <%= link_to(url_for([:home, current_object, event: event, format: :js]),remote: true, method: :put, class: "dropdown-item") do %>
            <%= current_object.class.human_attribute_name(event) %>
          <% end %>
        <% end %>
      </ul>
    </div>
  </div>

  <p><%= current_object.role_human %></p>

  <p><%= current_object.name %></p>

  <p><%= current_object.phone %></p>

  <div class="flex items-center justify-center">
    <% if current_object.note.present? %>
      <!-- Button trigger modal -->
      <button type="button" class="text-purple-theme hover:text-purple-theme-light duration-200" data-bs-toggle="modal" data-bs-target="#<%= dom_id(current_object) %>-note">
        <i class="fa-solid fa-circle-info"></i>
      </button>

      <!-- Modal -->
      <div class="modal fade" id="<%= dom_id(current_object) %>-note" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="exampleModalLabel">備註</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
              </button>
            </div>
            <div class="modal-body">
              <pre><%= current_object.note %></pre>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-center gap-3 duration-200">

    <a href="<%= url_for(action: :edit, id: current_object.id) %>" class=" hover:text-gray-theme-light duration-200">
      <i class="fa-solid fa-pen-to-square"></i>
    </a>

    <%= link_to(url_for(action: :destroy, id: current_object.id, format: :js),class: "hover:text-red-theme duration-200", remote: true, method: :delete, data: {confirm: t("backends.confirm", action:  t("backends.destroy")) }) do %>
      <i class="fa-solid fa-trash-can"></i>
    <% end %>

  </div>
</div>