<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= display_meta_tags %>

    <%= Gon::Base.render_data %>
    <%= stylesheet_link_tag "home", media: 'all' %>
    <%= stylesheet_link_tag "tailwind", "inter-font" %>


    <%= javascript_include_tag "application" %>

    <%= tag.meta name: "direct-upload-url", content: rails_direct_uploads_path %>

  </head>

  <body>
    <main class="flex min-h-screen h-screen bg-orange-theme-lightest">
      <%= render partial: "/home/partials/sidebar" %>

      <div class="flex-1 h-full bg-orange-theme-lightest overflow-y-auto">
				<%= render partial: "/home/partials/header" %>

        <div class="p-6 pt-0 flex flex-col gap-6" style="padding-bottom: 4rem;">
          <%= yield %>
        </div>
      </div>
    </main>
  </body>

</html>
