<a href="<%= checkin_activity_guests_path(current_object) %>" class="card card-event <%= 'active' if params[:activity_id] == current_object.id.to_s %>">
  <div class="flex items-center justify-between">
    <span><%= date_format current_object.date %></span>

    <div class="flex items-center gap-3">
      <span class="text-sm"><%= current_object.guests.count %> 人</span>

      <div class="tag active">已報到 <%= current_object.guests.registrated.count %> 人</div>
    </div>
  </div>

  <h3><%= current_object.name %></h3>
</a>