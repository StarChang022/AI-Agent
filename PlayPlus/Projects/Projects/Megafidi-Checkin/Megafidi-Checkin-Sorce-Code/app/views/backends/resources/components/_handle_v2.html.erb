<% controller = "backends/#{current_object.class.name.tableize}" if local_assigns[:controller].nil? %>

<div class="btn-group btn-group-sm">
  <button type="button" class="btn btn-light handle">
    <i class="bx bx-move" aria-hidden="true"></i>
  </button>
  <button type="button" class="btn btn-light dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">  <span class="visually-hidden">Toggle Dropdown</span>
  </button>
  <ul class="dropdown-menu">
    <% %w[move_to_top move_to_bottom].each do |current| %>
      <%= link_to(url_for([:backends, current_object, action: :acts_as_list, event: current]), method: :post, class: "dropdown-item") do %>
      <%= t("backends.#{current}") %>
      <% end %>
    <% end %>
    <div class="dropdown-divider"></div>
    <% %w[insert_at].each do |current| %>
      <%= link_to(url_for([:backends, current_object, action: :acts_as_list, event: current]), method: :post, class: "dropdown-item", data: {"param-name": "priority", "prompt": "移動到第幾個位置？"}) do %>
      <%= t("backends.#{current}") %>
      <% end %>
    <% end %>
  </ul>
</div>