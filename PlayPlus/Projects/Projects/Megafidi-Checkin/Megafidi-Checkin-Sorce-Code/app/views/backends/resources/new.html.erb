<% content_for :navigation do %>

<%= link_to(url_for(action: :index), class: "btn btn-sm btn-light px-3") do %>
<i class="bx bx-arrow-back"></i> <%= t('backends.back') %>
<% end %>

<% end %>
<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header text-uppercase">
        <%= model_class.model_name.human %>
      </div>
      <div class="card-body">
        <%= render partial: "form",locals: {current_object: current_object}  %>
      </div>
    </div>
  </div>
</div>