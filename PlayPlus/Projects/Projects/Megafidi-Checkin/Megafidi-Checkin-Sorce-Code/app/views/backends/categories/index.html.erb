
<% content_for :navigation do %>

<%= link_to(url_for(action: :index), class: "btn btn-sm btn-light px-3") do %>
<i class="bx bx-arrow-back"></i> <%= t('backends.back') %>
<% end if params[:id].present?  %>

<%= link_to(url_for(action: :new, params_key => {parent_id: @initialize_object.parent_id}), class: "btn btn-sm btn-light px-3") do %>
<i class="bx bx-plus"></i> <%= t("backends.new") %>
<% end %>

<% end %>


<div class="row">
  <div class="col">
    <div class="card">
      <div class="card-header text-uppercase">
        <a href="#search-body" class="text-white shadow-none">
          <%= t('backends.search') %>
        </a>
      </div>
      <div>
        <div class="card-body">
          <%= render partial: "search" %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <%= raw pagy_bootstrap_nav(current_pagy) %>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header text-uppercase">
        <%= model_class.model_name.human %>
      </div>
      <div class="card-body">
        <%= render partial: "table" %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-12">
    <%= raw pagy_bootstrap_nav(current_pagy) %>
  </div>
</div>


