<% i18n_scope = "devise.mailer.email_changed" %>
<%= content_for(:subject, t("#{i18n_scope}.subject"))  %>

<table width="100%" cellpadding="0" cellspacing="0">
	<tr>
		<td class="content-block">
			<h4><%= t("#{i18n_scope}.greeting", recipient: @email) %></h4>
		</td>
	</tr>
	<tr>
		<td class="content-block">
			<% if @resource.try(:unconfirmed_email?) %>
			<p><%= t("#{i18n_scope}.message", email: @resource.unconfirmed_email) %></p>
			<% else %>
			<p><%= t("#{i18n_scope}.message", email: @resource.email) %></p>
			<% end %>
		</td>
	</tr>
</table>