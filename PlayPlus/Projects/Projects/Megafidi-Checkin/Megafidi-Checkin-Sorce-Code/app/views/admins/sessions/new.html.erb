<%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "") do |f| %>
  <div class="w-full h-full flex items-center justify-center">
    <article class="card w-[360px] !py-6">
      <h1 class="text-2xl">邁佳數位報到系統</h1>

      <div class="input">
        <%= f.label :login, class: "" %>
        <%= f.email_field :login, autofocus: true, autocomplete: "email", class: "" %>
      </div>

      <div class="input">
        <%= f.label :password, class: "" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "current-password", class: "" %>
      </div>

      <div class="checkbox">
        <input id="remember-me" type="checkbox">

        <label for="remember-me">記住我</label>
      </div>

      <button type="submit" class="button">登入</button>
    </article>
  </div>
<% end %>
