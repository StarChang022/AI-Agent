<% i18n_scope = "devise.mailer.password_change" %>
<%= content_for(:subject, t("#{i18n_scope}.subject"))  %>

<table width="100%" cellpadding="0" cellspacing="0">
	<tr>
		<td class="content-block">
			<p><%= t("#{i18n_scope}.greeting", recipient: @resource.email) %></p>
		</td>
	</tr>
	<tr>
		<td class="content-block">
			<p><%= t("#{i18n_scope}.message") %></p>
		</td>
	</tr>
</table>
