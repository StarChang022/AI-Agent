<div class="card card-authentication1 mb-0">
  <div class="card-body">
    <div class="card-content p-2">
      <div class="card-title text-uppercase pb-2">Reset Password</div>
      <p class="pb-2">Please enter your email address. You will receive a link to create a new password via email.</p>
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <%= render "/admins/shared/error_messages", resource: resource %>
      <div class="form-group">
        <label for="exampleInputPassword" class="sr-only"><%= f.label :password, "New password" %></label>
        <div class="position-relative has-icon-right">
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control input-shadow" %>
          <div class="form-control-position">
            <i class="icon-lock"></i>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label for="exampleInputPassword" class="sr-only"><%= f.label :password_confirmation, "Confirm new password" %></label>
        <div class="position-relative has-icon-right">
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control input-shadow" %>
          <div class="form-control-position">
            <i class="icon-lock"></i>
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-light btn-block mt-3">Reset Password</button>
      <% end %>
    </div>
  </div>
  <div class="card-footer text-center py-3">
    <p class="text-warning mb-0">Return to the <a href="<%= new_admin_session_path %>"> Sign In</a></p>
  </div>
</div>