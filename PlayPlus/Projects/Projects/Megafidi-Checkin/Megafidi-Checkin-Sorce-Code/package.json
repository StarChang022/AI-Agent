    "build:tailwindcss": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "build:css": "sass ./app/assets/stylesheets/home.scss:./app/assets/builds/home.css ./app/assets/stylesheets/backends.scss:./app/assets/builds/backends.css --no-source-map --no-source-map --load-path=node_modules"
  },
  "devDependencies": {
    "chokidar": "^3.5.3"
  }
