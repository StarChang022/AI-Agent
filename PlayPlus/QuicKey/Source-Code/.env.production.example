# ============================================================
# Quickey production 環境變數範本
# ============================================================
# 正式部署時 .env 由 GitHub Actions（.github/workflows/deploy.yml）
# 依 GitHub Secrets 自動產生，本檔只當欄位說明參考。
#
# ⚠️  .env 已在 .gitignore 內，請勿 commit 進版本控制。
# ⚠️  密碼請用 `openssl rand -base64 32` 之類產生強隨機值。
# ============================================================

# ---- PostgreSQL ----
# db container 的 postgres superuser 密碼（管理用途，Rails 不用這個）
POSTGRES_SUPERUSER_PASSWORD=change-me-to-a-strong-random-string

# Rails 應用層 user `backend` 的密碼（init-db.prod.sh 建立 user 時會用）
# 這個密碼同時給 Rails 連 DB 用，兩邊必須一致。
BACKEND_DATABASE_PASSWORD=change-me-to-another-strong-random-string

# ---- Rails ----
# Rails master key，用來解密 config/credentials.yml.enc
# 取得方式：在本機跑 `cat backend/config/master.key` 複製貼過來
RAILS_MASTER_KEY=paste-the-content-of-backend-config-master-key-here
