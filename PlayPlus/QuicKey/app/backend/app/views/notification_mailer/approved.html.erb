<!DOCTYPE html>
<html>
  <body>
    <p><%= @name %> 您好，</p>
    <p>您的請款簽核已通過</p>
    <p>
      類別：<%= @reimbursement.category&.name %><br>
      金額：<%= money(@reimbursement.amount) %><br>
      <% if @reimbursement.description.present? %>描述：<%= @reimbursement.description %><br><% end %>
      預計發放日期：<%= @planned_payout_date %>
    </p>
    <p><a href="<%= @url %>">查看請款進度</a></p>
    <p>—— Quickey Team</p>
  </body>
</html>
